<wizard:WizardPage x:Class="MKW.GUI.CreateDatabaseLocation"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:MKW.GUI"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   xmlns:behaviors="clr-namespace:MKW.GUI.Behaviors"
                   xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
                   d:DataContext="{d:DesignInstance Type=local:CreateDatabaseWizardViewModel}"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White"
                   FocusManager.FocusedElement="{Binding ElementName=DatabaseNameInput}">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <Label Content="File _Name:"
             Padding="0"
             Margin="0,0,0,3" />

      <TextBox Text="{Binding DatabaseName, Mode=TwoWay}"
               d:Text="New Database.mkw"
               x:Name="DatabaseNameInput"
               Padding="3"
               Margin="0,0,0,6"
               behaviors:TextBoxBehavior.SelectAllTextOnFocus="True">
      </TextBox>

      <Label Content="_Location:"
             Padding="0"
             Margin="0,0,0,3" />

      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <TextBox Text="{Binding DatabaseDirectory, Mode=TwoWay}"
                 d:Text="C:\tima\Documents"
                 Padding="3"
                 Margin="0,0,3,0"
                 behaviors:TextBoxBehavior.SelectAllTextOnFocus="True" />

        <Button Grid.Column="1" Padding="3" Click="SelectFolder_Click">
          <images:OpenFolder />
        </Button>
      </Grid>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
