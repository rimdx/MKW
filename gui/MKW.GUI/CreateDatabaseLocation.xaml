<wizard:WizardPage x:Class="MKW.GUI.CreateDatabaseLocation"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:MKW.GUI"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   d:DataContext="{d:DesignInstance Type=local:CreateDatabaseWindowViewModel}"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White"
                   FocusManager.FocusedElement="{Binding ElementName=ctlDatabaseName}">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <Label Content="File _Name:"
             Padding="0"
             Margin="0,0,0,3" />

      <TextBox Text="{Binding DatabaseName, Mode=TwoWay}"
               d:Text="New Database.mkw"
               x:Name="ctlDatabaseName"
               Padding="3"
               Margin="0,0,0,6">
      </TextBox>

      <Label Content="_Location:"
             Padding="0"
             Margin="0,0,0,3" />

      <TextBox Text="{Binding DatabaseDirectory, Mode=TwoWay}"
               d:Text="C:\tima\Documents"
               Padding="3"
               Margin="0,0,0,6">
      </TextBox>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
