<local:DialogWindow x:Class="MKW.GUI.UserPropertyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
        d:DataContext="{d:DesignInstance Type=local:UserPropertyDialogViewModel}"
        mc:Ignorable="d"
        Title="Properties" Height="500" Width="400">
  <local:DialogWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </local:DialogWindow.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Vertical">
      <Border Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
              Visibility="{Binding IsUntrusted, Converter={StaticResource BooleanToVisibilityConverter}}"
              CornerRadius="6"
              Padding="9"
              Margin="0,0,0,6">
        <StackPanel Orientation="Vertical">
          <StackPanel Orientation="Horizontal"  Margin="0,0,0,6">
            <images:StatusWarning HorizontalAlignment="Left" Width="22" />
            <TextBlock Text="This user is not verified. " />
          </StackPanel>

          <TextBlock Text="Only the database owner can verify other users."
                     Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <TextBlock Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Hyperlink Click="VerifyUser_Click">Verfiy this user</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Border>

      <Label Padding="0" Margin="0,0,0,3"
             Content="User ID:" Target="UserIdTextBox" />

      <TextBox x:Name="UserIdTextBox"
               IsReadOnly="True"
               Text="{Binding UserId, Mode=OneWay}"
               Padding="4,2"
               Margin="0,0,0,6" />

      <Label Padding="0" Margin="0,0,0,3"
             Content="Public Key:" Target="PublicKeyTextBox" />

      <TextBox x:Name="PublicKeyTextBox"
               Height="120"
               IsReadOnly="True"
               Text="{Binding PublicKey, Mode=OneWay}"
               FontFamily="Consolas"
               Padding="4,2"
               Margin="0,0,0,6" />
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="1"
              Content="OK"
              Width="70"
              Click="OK_Click"
              IsDefault="True"
              Margin="0,0,6,0" />

      <Button Grid.Column="3"
              Content="Cancel"
              Width="70"
              Click="Cancel_Click"
              IsCancel="True" />
    </Grid>
  </Grid>
</local:DialogWindow>
