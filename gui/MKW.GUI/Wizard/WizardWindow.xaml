<Window x:Class="MKW.GUI.Wizard.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type wizard:WizardViewModel}}"
        Title="WizardWindow"
        Height="380" Width="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="135" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ListView Grid.Column="0"
              ItemContainerStyle="{StaticResource ListViewItemStyle}"
              BorderThickness="1,0,1,1"
              SnapsToDevicePixels="True">
      <ListViewItem>First Page</ListViewItem>
      <ListViewItem>Second Page</ListViewItem>
      <ListViewItem>Confirmation Page</ListViewItem>
    </ListView>

    <Border Grid.Column="2"
            BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="1">
      <ContentControl x:Name="PageContent" />
    </Border>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3">
      
      <Button Content="_Back"
              Width="70"
              Margin="0,0,6,0"
              Click="Back_Click"
              IsEnabled="{Binding CanGoBack}"/>

      <Button Content="_Next"
              Width="70"
              IsDefault="True"
              Margin="0,0,12,0"
              Click="Next_Click"
              IsEnabled="{Binding CanGoNext}"/>

      <Button Content="_Finish"
              Width="70"
              IsDefault="True"
              Margin="0,0,6,0"
              Click="Finish_Click"
              IsEnabled="{Binding CanFinish}" />
      
      <Button Content="_Cancel"
              Width="70"
              IsCancel="True"
              Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
