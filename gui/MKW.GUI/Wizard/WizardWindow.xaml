<local:DialogWindow x:Class="MKW.GUI.Wizard.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type wizard:WizardViewModel}}"
        Title="WizardWindow"
        Height="380" Width="520">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{DynamicResource ResourceKey={x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1"
            Margin="0,0,0,6"
            Padding="12">

      <Label Content="{Binding PageHeader}"
             Padding="0"
             FontWeight="SemiBold" />
    </Border>

    <Border Grid.Row="1">
      <ContentPresenter x:Name="PageContent" />
    </Border>

    <Border Grid.Row="3" Padding="12"
            Background="{DynamicResource ResourceKey={x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right">
      
        <Button Content="_Back"
                Width="70"
                Margin="0,0,6,0"
                Click="Back_Click"
                IsEnabled="{Binding CanGoBack}"/>

        <Button Content="_Next"
                Width="70"
                IsDefault="True"
                Margin="0,0,12,0"
                Click="Next_Click"
                IsEnabled="{Binding CanGoNext}"/>

        <Button Content="_Finish"
                Width="70"
                IsDefault="True"
                Margin="0,0,6,0"
                Click="Finish_Click"
                IsEnabled="{Binding CanFinish}" />
      
        <Button Content="_Cancel"
                Width="70"
                IsCancel="True"
                Click="Cancel_Click" />
      </StackPanel>
    </Border>
  </Grid>
</local:DialogWindow>
