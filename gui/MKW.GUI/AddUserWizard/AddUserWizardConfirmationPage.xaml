<wizard:WizardPage x:Class="MKW.GUI.AddUserWizard.AddUserWizardConfirmationPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:gui="clr-namespace:MKW.GUI"
                   xmlns:local="clr-namespace:MKW.GUI.AddUserWizard"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <TextBlock TextWrapping="Wrap"
                 Margin="0,0,0,12">
        This will add the user to the database and share all existing and future
        entries in the database. Please verify that the information below is
        correct and you trust this user.
      </TextBlock>

      <Label Margin="0,0,0,3" Padding="0" Content="User name:" />
      <TextBox Margin="0,0,0,6" Padding="3" IsReadOnly="True">TODO</TextBox>

      <Label Margin="0,0,0,3" Padding="0" Content="Public key fingerprint:" />
      <TextBox Margin="0,0,0,6" Padding="3" IsReadOnly="True">TODO</TextBox>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
