<Window x:Class="MKW.GUI.CreateDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:CreateDatabaseWindowViewModel}"
        Title="Create Database"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Vertical">
      <Label Content="Create Master Key"
             Padding="0"
             Margin="0,0,0,3" />
      
      <TextBox IsReadOnly="True"
               Text="{Binding DatabasePath, Mode=OneWay}"
               d:Text="C:\path\to\database.mkw"
               Margin="8,0,0,6">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          </Style>
        </TextBox.Style>
      </TextBox>
      
      <TextBox IsReadOnly="True"
               Margin="0,0,0,6">
        <TextBox.Style>
          <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          </Style>
        </TextBox.Style>
        This is the mater password that protects your database. It will be
        required every time you unlock or access your stored passwords.
        Choose a strong, memorable password — if you forget it, your data
        cannot be recovered.
      </TextBox>
      
      <local:PasswordRepeatInput x:Name="PasswordInput"
                                 Password="{Binding Password, Mode=OneWayToSource}"
                                 IsPasswordMatch="{Binding IsPasswordMatch, Mode=OneWayToSource}">
        <local:PasswordRepeatInput.Template>
          <ControlTemplate TargetType="{x:Type local:PasswordRepeatInput}">
            <StackPanel Orientation="Vertical">
              <Label Padding="0"
                     Target="{Binding ElementName=PART_PasswordBox}"
                     Content="_Password:"
                     Margin="0,0,0,3" />
      
              <PasswordBox x:Name="PART_PasswordBox"
                           Padding="4"
                           FontFamily="Consolas"
                           Margin="0,0,0,6" />
      
              <Label Padding="0"
                     Target="{Binding ElementName=PART_PasswordRepeatBox}"
                     Content="_Repeat Password:"
                     Margin="0,0,0,3" />
      
              <PasswordBox x:Name="PART_PasswordRepeatBox"
                           Padding="4"
                           FontFamily="Consolas"
                           Margin="0,0,0,6" />
            </StackPanel>
          </ControlTemplate>
        </local:PasswordRepeatInput.Template>
      </local:PasswordRepeatInput>
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

      <Button Content="OK" Width="70" Click="OK_Click" IsDefault="True" Margin="0,0,6,0" />
      <Button Content="Cancel" Width="70" Click="Cancel_Click" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
