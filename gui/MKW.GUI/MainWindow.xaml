<Window x:Class="MKW.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="450" Width="800"
        Closed="Window_Closed">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu Grid.Column="0" Grid.Row="0">
      <MenuItem Header="_File" >
        <MenuItem Header="_New" Click="NewDatabase_Click" />
        <MenuItem Header="_Open" Click="OpenDatabase_Click" />

        <MenuItem Header="_Recent Files"
                  ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding Path=HasItems, RelativeSource={RelativeSource Self}}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="MenuItem">
                    <MenuItem Header="{Binding FileName}"
                              Click="RecentFileItem_Click" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Close" Click="Close_Click" />
        <Separator />
        <MenuItem Header="_Exit" Click="Exit_Click" />
      </MenuItem>

      <MenuItem Header="_Entry">
        <MenuItem Header="Add Entry" />

        <MenuItem Header="Edit Entry" />

        <MenuItem Header="Delete Entry" />
      </MenuItem>

      <MenuItem Header="_User">
        <MenuItem Header="_New User..." />

        <MenuItem Header="_Properties..." />

        <MenuItem Header="_Delete..." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Multi-Key Wallet"
                  Click="HelpAbout_Click" />
      </MenuItem>
    </Menu>

    <TabControl Grid.Row="1" 
                ItemsSource="{Binding TabItems}"
                SelectedItem="{Binding SelectedTab}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Header}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.Resources>
        <DataTemplate DataType="{x:Type local:WelcomeTabItemViewModel}">
          <StackPanel>
            <ContentControl Content="{Binding Content}" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DatabaseTabItemViewModel}">
          <ContentControl Content="{Binding Content}" />
        </DataTemplate>
      </TabControl.Resources>
    </TabControl>
  </Grid>
</Window>
