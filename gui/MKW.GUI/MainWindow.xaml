<Window x:Class="MKW.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="450" Width="800"
        Closed="Window_Closed">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Open"
                    Executed="FileOpenCommand_Executed" />
  </Window.CommandBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu Grid.Column="0" Grid.Row="0">
      <MenuItem Header="_File" >
        <MenuItem Header="_New" Click="NewDatabase_Click" />
        <MenuItem Header="_Open" Command="ApplicationCommands.Open" />

        <MenuItem Header="_Recent Files"
                  ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding Path=HasItems, RelativeSource={RelativeSource Self}}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="MenuItem">
                    <MenuItem Header="{Binding FileName}"
                              Click="RecentFileItem_Click" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Close" Click="Close_Click" />
        <Separator />
        <MenuItem Header="_Exit" Click="Exit_Click" />
      </MenuItem>

      <MenuItem Header="_Entry">
        <MenuItem Header="Add Entry" />

        <MenuItem Header="Edit Entry" />

        <MenuItem Header="Delete Entry" />
      </MenuItem>

      <MenuItem Header="_User">
        <MenuItem Header="_New User..." />

        <MenuItem Header="_Properties..." />

        <MenuItem Header="_Delete..." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Multi-Key Wallet"
                  Click="HelpAbout_Click" />
      </MenuItem>
    </Menu>

    <ContentPresenter
      Grid.Row="1"
      Content="{Binding StartPage}"
      Visibility="{Binding IsStartPageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
      />

    <TabControl Grid.Row="1" 
                ItemsSource="{Binding TabItems}"
                SelectedItem="{Binding SelectedTab}"
                Visibility="{Binding IsTabControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Header}"
                       Margin="0,0,3,0" />

            <Button Padding="1"
                    Margin="0,2,0,0"
                    Height="14"
                    Background="Transparent"
                    Foreground="Transparent"
                    BorderThickness="0"
                    Click="TabClose_Click">
              <images:Close Width="12" Height="12" />
            </Button>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.Resources>
        <DataTemplate DataType="{x:Type local:DatabaseTabItemViewModel}">
          <ContentPresenter Content="{Binding Content}" />
        </DataTemplate>
      </TabControl.Resources>
    </TabControl>
  </Grid>
</Window>
