<wizard:WizardPage x:Class="MKW.GUI.CreateDatabaseMasterPassword"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:MKW.GUI"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   d:DataContext="{d:DesignInstance Type=local:CreateDatabaseWizardViewModel}"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <Label Padding="0"
             Content="_Password:"
             Margin="0,0,0,3" />

      <PasswordBox x:Name="ctlPassword"
                   Padding="4"
                   FontFamily="Consolas"
                   Margin="0,0,0,6" />

      <Label Padding="0"
             Content="_Repeat Password:"
             Margin="0,0,0,3" />

      <PasswordBox x:Name="ctlPasswordRepeat"
                   Padding="4"
                   FontFamily="Consolas"
                   Margin="0,0,0,12" />

      <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
        This is the mater password that protects your database. It will be
        required every time you unlock or access your stored passwords.
        Choose a strong, memorable password — if you forget it, your data
        cannot be recovered.
      </TextBlock>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
