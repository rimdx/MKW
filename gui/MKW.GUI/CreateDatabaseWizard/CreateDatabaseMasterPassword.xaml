<wizard:WizardPage x:Class="MKW.GUI.CreateDatabaseMasterPassword"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:MKW.GUI"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   d:DataContext="{d:DesignInstance Type=local:CreateDatabaseWizardViewModel}"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <Label Padding="0"
             Content="_Password:"
             Margin="0,0,0,3" />

      <PasswordBox x:Name="ctlPassword"
                   Padding="4"
                   FontFamily="Consolas"
                   PasswordChanged="ctlPassword_PasswordChanged" />

      <Grid Margin="0,3,0,0" >
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:CrispImage Grid.Column="0"
                           Height="16"
                           Moniker="{Binding PasswordQualityIcon}"
                           Margin="0,0,3,0"/>

        <TextBlock Grid.Column="1">
          <TextBlock.Inlines>
            Approximate password entropy is
            <Run Text="{Binding PasswordEntropy, Mode=OneWay, StringFormat=0}" d:Text="18" FontWeight="SemiBold"/>
            bits (
            <Run Text="{Binding PasswordLength, Mode=OneWay}" d:Text="8" FontWeight="SemiBold" /> characters)
          </TextBlock.Inlines>
        </TextBlock>
      </Grid>

      <Label Padding="0"
             Content="_Repeat Password:"
             Margin="0,6,0,3" />

      <PasswordBox x:Name="ctlPasswordRepeat"
                   Padding="4"
                   FontFamily="Consolas"
                   Margin="0,0,0,12" 
                   PasswordChanged="ctlPasswordRepeat_PasswordChanged">
        <PasswordBox.Style>
          <Style TargetType="PasswordBox">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Path=PasswordMismatch}" Value="True">
                <Setter Property="Background" Value="#FFA52C" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </PasswordBox.Style>
      </PasswordBox>

      <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
        This is the mater password that protects your database. It will be
        required every time you unlock or access your stored passwords.
        Choose a strong, memorable password — if you forget it, your data
        cannot be recovered.
      </TextBlock>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
