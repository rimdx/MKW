<UserControl x:Class="MKW.GUI.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
             d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Column="1"
                Grid.Row="1">

      <Label Content="Multi-Key Wallet"
             HorizontalAlignment="Center"
             Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
             FontSize="18" FontWeight="Bold" />

      <Separator Margin="0,8" />

      <Grid Grid.Row="1" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <images:OpenFile Grid.Row="2" />
        <TextBlock Grid.Column="1" Grid.Row="2">
        <Hyperlink Command="ApplicationCommands.Open">Open Database</Hyperlink>
        </TextBlock>
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <images:NewDocument Grid.Row="4" />

        <TextBlock Grid.Column="1" Grid.Row="4">
          <Hyperlink Command="ApplicationCommands.New">Create New Database</Hyperlink>
        </TextBlock>
      </Grid>
      
      <Separator Margin="0,8" />

      <Label FontWeight="Bold">Recent files</Label>

      <ItemsControl ItemsSource="{Binding RecentFiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="local:RecentFileItemViewModel">
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <images:OpenFile Grid.Row="2" />

              <TextBlock Grid.Column="1" Grid.Row="4">
                <Hyperlink Command="{x:Static local:AppCommands.OpenRecent}" CommandParameter="{Binding FullPath}">
                  <Run Text="{Binding FileName, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
