<wizard:WizardPage x:Class="MKW.GUI.RequestAccessWizard.RequestAccessWizardConfirmationPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:gui="clr-namespace:MKW.GUI"
                   xmlns:local="clr-namespace:MKW.GUI.RequestAccessWizard"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <TextBlock TextWrapping="Wrap"
                 Margin="0,0,0,6">
        This will create a request file that you can send to database owner
        to request access to the database.
      </TextBlock>

      <TextBlock TextWrapping="Wrap"
                 Margin="0,0,0,6">
        Please verify that the information below is correct before proceeding.
      </TextBlock>

      <StackPanel Orientation="Horizontal">
        <TextBlock Text="User name: " />
        <TextBlock Text="TODO" />
      </StackPanel>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
