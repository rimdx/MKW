<wizard:WizardPage x:Class="MKW.GUI.RequestAccessWizard.RequestAccessWizardPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gui="clr-namespace:MKW.GUI"
             xmlns:local="clr-namespace:MKW.GUI.RequestAccessWizard"
             xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
             mc:Ignorable="d"
             d:DesignHeight="380" d:DesignWidth="520"
             d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <gui:PasswordRepeatInput Password="{Binding Password, Mode=OneWayToSource}"
                                 IsPasswordMatch="{Binding IsPasswordMatch, Mode=OneWayToSource}">
        <gui:PasswordRepeatInput.Template>
          <ControlTemplate TargetType="{x:Type gui:PasswordRepeatInput}">
            <StackPanel Orientation="Vertical">
              <Label Padding="0"
                     Target="{Binding ElementName=PART_PasswordBox}"
                     Content="_Password:"
                     Margin="0,0,0,3" />

              <PasswordBox x:Name="PART_PasswordBox"
                           Padding="4"
                           FontFamily="Consolas"
                           Margin="0,0,0,6" />

              <Label Padding="0"
                     Target="{Binding ElementName=PART_PasswordRepeatBox}"
                     Content="_Repeat Password:"
                     Margin="0,0,0,3" />

              <PasswordBox x:Name="PART_PasswordRepeatBox"
                           Padding="4"
                           FontFamily="Consolas"
                           Margin="0,0,0,6" />
            </StackPanel>
          </ControlTemplate>
        </gui:PasswordRepeatInput.Template>
      </gui:PasswordRepeatInput>

      <TextBlock TextWrapping="Wrap">
          Please choose a strong password and memoisable, which will be needed
          each time to unlock the database. This password will
          not be visible to other people.
      </TextBlock>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
