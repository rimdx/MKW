<wizard:WizardPage x:Class="MKW.GUI.RequestAccessWizard.ConfirmationPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:gui="clr-namespace:MKW.GUI"
                   xmlns:local="clr-namespace:MKW.GUI.RequestAccessWizard"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <TextBlock TextWrapping="Wrap"
                 Margin="0,0,0,6">
        Please verify that the information below is correct before proceeding.
      </TextBlock>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="User details" FontWeight="SemiBold" />

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Identifier:" />
        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding UserName}" d:Text="john@contoso.com" />

        <TextBlock Grid.Row="2" Grid.Column="1" Text="Display name:" />
        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding UserDisplayName}" d:Text="John Doe" />
      </Grid>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
