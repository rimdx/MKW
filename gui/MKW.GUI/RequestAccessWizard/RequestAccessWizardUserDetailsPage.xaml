<wizard:WizardPage x:Class="MKW.GUI.RequestAccessWizard.RequestAccessWizardUserDetailsPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   xmlns:local="clr-namespace:MKW.GUI.RequestAccessWizard"
                   xmlns:gui="clr-namespace:MKW.GUI"
                   d:DataContext="{d:DesignInstance Type=local:RequestAccessWizardViewModel}"
                   mc:Ignorable="d"
                   Background="White"
                   d:DesignHeight="301.667" d:DesignWidth="487">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <Label Padding="0"
             Content="_User ID:"
             Margin="0,0,0,3" />

      <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
               d:Text="sally@contoso.com"
               Padding="3" />

      <Grid Margin="0,3,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <gui:CrispImage Grid.Column="0"
                        Height="16"
                        Moniker="StatusHelp"
                        Margin="0,0,3,0"
                        VerticalAlignment="Top"/>

        <TextBlock Grid.Column="1"
                   TextWrapping="Wrap">
          User ID can be in any format accepted by database owner, but it's
          recommended to your email.
        </TextBlock>
      </Grid>

      <Label Padding="0"
             Content="Display name (optional):"
             Margin="0,12,0,3" />

      <TextBox Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}"
               Padding="3"
               d:Text="John Doe" />
    </StackPanel>
  </Grid>
</wizard:WizardPage>
