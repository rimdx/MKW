<UserControl x:Class="MKW.GUI.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseModel}"
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ListView Grid.Row="1" ItemsSource="{Binding Entries}">
      <ListView.View>
        <GridView>
          <GridView.Columns>
            <GridViewColumn Header="Entry ID" Width="250" DisplayMemberBinding="{Binding Id}" />
            <GridViewColumn Header="Payload" Width="300" DisplayMemberBinding="{Binding Payload}" />
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</UserControl>
