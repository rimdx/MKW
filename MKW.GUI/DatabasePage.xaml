<UserControl x:Class="MKW.GUI.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TreeView Grid.Row="1"
              Grid.Column="0"
              BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.ControlBrushKey}}"
              BorderThickness="1">
      <TreeViewItem IsExpanded="True">
        <TreeViewItem.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <images:Database />
            <TextBlock Grid.Column="1">Database</TextBlock>
          </Grid>
        </TreeViewItem.Header>

        <TreeViewItem>
          <TreeViewItem.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <images:AsymmetricKey />
              <TextBlock Grid.Column="1">Entries</TextBlock>
            </Grid>
          </TreeViewItem.Header>
        </TreeViewItem>

        <TreeViewItem>
          <TreeViewItem.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <images:Team />
              <TextBlock Grid.Column="1">Users</TextBlock>
            </Grid>
          </TreeViewItem.Header>
        </TreeViewItem>
      </TreeViewItem>
    </TreeView>

    <ListView Grid.Row="1"
              Grid.Column="2"
              ItemsSource="{Binding Entries}"
              ItemContainerStyle="{StaticResource GridViewItemStyle}"
              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
              MouseDoubleClick="EntryListView_MouseDoubleClick" SnapsToDevicePixels="True"
              BorderBrush="{DynamicResource ResourceKey={x:Static SystemColors.ControlBrushKey}}"
              BorderThickness="1">
      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="_Copy payload" IsEnabled="{Binding IsEntrySelected}" />
          <Separator />
          <MenuItem Header="_Add Entry" Click="AddEntry_Click" />
          <MenuItem Header="_Edit Entry" Click="EditEntry_Click" IsEnabled="{Binding IsEntrySelected}" />
          <MenuItem Header="Duplicate Entry" IsEnabled="{Binding IsEntrySelected}" />
          <MenuItem Header="_Delete Entry" IsEnabled="{Binding IsEntrySelected}" />
          <Separator />
          <MenuItem Header="Select All" />
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.View>
        <GridView>
          <GridView.Columns>
            <GridViewColumn Header="Entry ID" Width="250" DisplayMemberBinding="{Binding Id}" />
            <GridViewColumn Header="Payload" Width="300" DisplayMemberBinding="{Binding Payload}" />
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</UserControl>
