<Window x:Class="MKW.GUI.NewEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:NewEntryWindowViewModel}"
        Title="Create new secret entry"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
      <RowDefinition Height="8" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <Label Grid.Row="0"
           Content="Entry content:"
           FontWeight="Bold"
           Target="Payload" />

    <TextBox Grid.Row="2"
             x:Name="Payload"
             Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
             FontFamily="Consolas"
             AcceptsReturn="True" />

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="1" Content="OK" Width="70" Click="OK_Click" IsDefault="True" />
      <Button Grid.Column="3" Content="Cancel" Width="70" Click="Cancel_Click" IsCancel="True" />
    </Grid>
  </Grid>
</Window>
