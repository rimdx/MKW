<Window x:Class="MKW.GUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:LoginWindowModel}"
        Title="Open Database"
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <Grid Margin="7">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="4" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <Label Grid.Row="0"
           Content="Enter database credentials:"
           FontWeight="Bold" />

    <TextBox Grid.Row="1"
             IsReadOnly="True"
             Text="{Binding DatabasePath, Mode=OneWay}"
             d:Text="C:\path\to\database.mkw"
             Margin="8,0,0,0">
      <TextBox.Style>
        <Style TargetType="TextBox">
          <Setter Property="IsReadOnly" Value="True" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
      </TextBox.Style>
    </TextBox>

    <StackPanel Orientation="Vertical" Grid.Row="4">
      <RadioButton GroupName="Password"
                   IsChecked="{Binding IsUserPassword}"
                   HorizontalContentAlignment="Stretch"
                   Margin="0,0,0,8">
        <RadioButton.Content>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Padding="0"
                   FontWeight="Bold"
                   Target="{Binding ElementName=UserPasswordInput}"
                   Content="_User Password:" />

            <TextBox Grid.Row="1"
                     Padding="4"
                     x:Name="UserPasswordInput"
                     FontFamily="Consolas"
                     IsEnabled="{Binding IsUserPassword}"
                     Text="{Binding Password, Mode=OneWayToSource}" />
          </Grid>
        </RadioButton.Content>
      </RadioButton>

      <RadioButton GroupName="Password"
                   IsChecked="{Binding IsAdminPassword}"
                   HorizontalContentAlignment="Stretch"
                   Margin="0,0,0,8">
        <RadioButton.Content>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Padding="0"
                   FontWeight="Bold"
                   Target="{Binding ElementName=AdminPasswordInput}"
                   Content="_Admin Password:" />

            <TextBox Grid.Row="1"
                     Padding="4"
                     x:Name="AdminPasswordInput"
                     FontFamily="Consolas"
                     IsEnabled="{Binding IsAdminPassword}"
                     Text="{Binding Password, Mode=OneWayToSource}" />
          </Grid>
        </RadioButton.Content>
      </RadioButton>

      <RadioButton GroupName="Password"
                   IsChecked="{Binding IsAnonymousMode}"
                   HorizontalContentAlignment="Stretch">
        <RadioButton.Content>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Padding="0"
                   FontWeight="Bold"
                   Content="View _anonymously" />

            <TextBox Grid.Row="1"
                     IsReadOnly="True"
                     IsEnabled="{Binding IsAnonymousMode}"
                     Text="Entries will not be visible">
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Setter Property="IsReadOnly" Value="True" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </Style>
              </TextBox.Style>
            </TextBox>
          </Grid>
        </RadioButton.Content>
      </RadioButton>
    </StackPanel>

    <Grid Grid.Row="7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="1" Content="OK" Width="70" Click="OK_Click" />
      <Button Grid.Column="3" Content="Cancel" Width="70" Click="Cancel_Click" />
    </Grid>
  </Grid>
</Window>
