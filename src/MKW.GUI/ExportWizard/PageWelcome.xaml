<wizard:WizardPage x:Class="MKW.GUI.ExportWizard.PageWelcome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:gui="clr-namespace:MKW.GUI"
                   xmlns:local="clr-namespace:MKW.GUI.ExportWizard"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=local:ExportWizardViewModel}"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
      </StackPanel.Resources>

      <TextBlock Margin="0,0,0,12">
        This wizard will guide you through the process...
      </TextBlock>
    </StackPanel>

  </Grid>
</wizard:WizardPage>
