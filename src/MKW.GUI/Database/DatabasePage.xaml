<UserControl x:Class="MKW.GUI.Database.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI.Database"
             xmlns:gui="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White"
             KeyboardNavigation.TabNavigation="Cycle">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </UserControl.Resources>
  <UserControl.CommandBindings>
    <CommandBinding Command="{x:Static gui:AppCommands.LockDatabase}"
                    Executed="LockDatabaseCommand_Executed" />
    <CommandBinding Command="{x:Static gui:AppCommands.UnlockDatabase}"
                    Executed="UnlockDatabaseCommand_Executed" />
  </UserControl.CommandBindings>

  <ContentPresenter Content="{Binding ContentView}" />
</UserControl>
