<UserControl x:Class="MKW.GUI.Database.DatabaseLockedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI.Database"
             xmlns:gui="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
             xmlns:model="clr-namespace:MKW.GUI.Model"
             xmlns:controls="clr-namespace:MKW.GUI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseLockedViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
          <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
          <gui:EqualityConverter x:Key="EqualityConverter" />
        </ResourceDictionary>

        <ResourceDictionary Source="/Styles/ListView.xaml" />

        <ResourceDictionary Source="/Controls/SelectorBox.xaml" />
        <ResourceDictionary Source="/Controls/SelectorBoxItem.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.CommandBindings>
  </UserControl.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <local:LoginProfileView x:Name="LoginProfileView"
                            Grid.Column="1" Grid.Row="1"
                            DataContext="{Binding Profile}" />

    <controls:SelectorBox Grid.RowSpan="3"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Left"
                          MinWidth="150"
                          BorderThickness="0"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          Margin="12">
      <controls:SelectorBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal"
                      Margin="3,3,12,3">
            <gui:CrispImage Moniker="{Binding Icon}"
                            Margin="0,0,6,0"
                            Height="32" />

            <TextBlock Text="{Binding ShortName}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </controls:SelectorBox.ItemTemplate>
    </controls:SelectorBox>
  </Grid>
</UserControl>
