<UserControl x:Class="MKW.GUI.Database.PageEntries"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI.Database"
             xmlns:gui="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
             xmlns:behaviors="clr-namespace:MKW.GUI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseUnlockedViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
  <Grid>
    <ListView Grid.Row="1"
              Grid.Column="2"
              ItemsSource="{Binding Entries}"
              Style="{StaticResource GridViewStyle}"
              ItemContainerStyle="{StaticResource GridViewItemStyle}"
              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
              BorderThickness="0"
              MouseDoubleClick="EntryListView_MouseDoubleClick"
              SnapsToDevicePixels="True"
              behaviors:ListViewBehavior.DeselectOnClickAway="True">

      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="_Add Entry..."
                    Command="{x:Static gui:EntryCommands.AddEntry}">
            <MenuItem.Icon>
              <gui:CrispImage Moniker="NewKey" />
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="_Edit Entry"
                    Command="{x:Static gui:EntryCommands.EditEntry}">
            <MenuItem.Icon>
              <gui:CrispImage Moniker="EditKey" />
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="_Delete Entry"
                    Command="{x:Static gui:EntryCommands.DeleteEntry}">
            <MenuItem.Icon>
              <gui:CrispImage Moniker="DeleteKey" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Select All"
                    Click="SelectAll_Click" />
        </ContextMenu>
      </ListView.ContextMenu>

      <ListView.View>
        <GridView>
          <GridView.Columns>
            <GridViewColumn Header="Title"
                            Width="175"
                            DisplayMemberBinding="{Binding Title}" />

            <GridViewColumn Header="User Name"
                            Width="175"
                            DisplayMemberBinding="{Binding Username}" />

            <GridViewColumn Header="Password"
                            Width="150"
                            DisplayMemberBinding="{Binding Password}" />

            <GridViewColumn Header="URL"
                            Width="150"
                            DisplayMemberBinding="{Binding Url}" />

            <GridViewColumn Header="Notes"
                            Width="225"
                            DisplayMemberBinding="{Binding Notes}" />
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</UserControl>
