<UserControl x:Class="MKW.GUI.Database.PageEntries"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI.Database"
             xmlns:gui="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
             xmlns:controls="clr-namespace:MKW.GUI.Controls"
             xmlns:model="clr-namespace:MKW.GUI.Model"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseUnlockedViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
  <Grid>
    <TextBlock TextWrapping="NoWrap" />
    <ListView Grid.Row="1"
              Grid.Column="2"
              ItemsSource="{Binding Entries}"
              ItemContainerStyle="{StaticResource GridViewItemStyle}"
              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
              BorderThickness="0"
              SnapsToDevicePixels="True"
              controls:ListViewBehavior.DeselectOnClickAway="True">
      <ListView.CommandBindings>
        <CommandBinding Command="{x:Static gui:ListViewCommands.DefaultAction}"
                        Executed="ListViewDefaultActionCommand_Executed" />
      </ListView.CommandBindings>

      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy _User Name"
                    Command="{x:Static gui:EntryCommands.CopyProperty}"
                    CommandTarget="{Binding UnlockedViewNeededToBindTheCommand}"
                    CommandParameter="{x:Static model:CommonEntryPropertiesModel.Username}" />

          <MenuItem Header="Copy _Password"
                    Command="{x:Static gui:EntryCommands.CopyProperty}"
                    CommandTarget="{Binding UnlockedViewNeededToBindTheCommand}"
                    CommandParameter="{x:Static model:CommonEntryPropertiesModel.Password}" />

          <Separator />

          <MenuItem Header="_Add Entry..."
                    Command="{x:Static gui:EntryCommands.AddEntry}"
                    CommandTarget="{Binding UnlockedViewNeededToBindTheCommand}">
            <MenuItem.Icon>
              <gui:CrispImage Moniker="NewKey" />
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="_Edit Entry"
                    Command="{x:Static gui:EntryCommands.EditEntry}"
                    CommandTarget="{Binding UnlockedViewNeededToBindTheCommand}">
            <MenuItem.Icon>
              <gui:CrispImage Moniker="EditKey" />
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="_Delete Entry"
                    Command="{x:Static gui:EntryCommands.DeleteEntry}"
                    CommandTarget="{Binding UnlockedViewNeededToBindTheCommand}">
            <MenuItem.Icon>
              <gui:CrispImage Moniker="DeleteKey" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Select All"
                    Click="SelectAll_Click" />
        </ContextMenu>
      </ListView.ContextMenu>

      <ListView.View>
        <GridView x:Name="gridView"
                  x:FieldModifier="private">
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</UserControl>
