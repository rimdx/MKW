<UserControl x:Class="MKW.GUI.Database.DatabaseUnlockedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI.Database"
             xmlns:gui="clr-namespace:MKW.GUI"
             xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DatabaseUnlockedViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
  <UserControl.CommandBindings>
    <CommandBinding Command="{x:Static gui:EntryCommands.AddEntry}"
                    Executed="AddEntryCommand_Executed" />
  </UserControl.CommandBindings>
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="100"  MaxWidth="300"/>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TreeView Grid.Row="1" BorderThickness="0">
      <TreeViewItem IsExpanded="True" IsSelected="{Binding IsPageDatabase, Mode=TwoWay}">
        <TreeViewItem.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <images:Database />
            <TextBlock Grid.Column="1">Database</TextBlock>
          </Grid>
        </TreeViewItem.Header>

        <TreeViewItem IsSelected="{Binding IsPageEntries, Mode=TwoWay}">
          <TreeViewItem.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <images:AsymmetricKey />
              <TextBlock Grid.Column="1">Entries</TextBlock>
            </Grid>
          </TreeViewItem.Header>
        </TreeViewItem>

        <TreeViewItem IsSelected="{Binding IsPageUsers, Mode=TwoWay}">
          <TreeViewItem.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <images:Team />
              <TextBlock Grid.Column="1">Users</TextBlock>
            </Grid>
          </TreeViewItem.Header>
        </TreeViewItem>
      </TreeViewItem>
    </TreeView>

    <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  Width="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsTabStop="False" 
                  BorderThickness="1,0,1,0"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

    <Grid Grid.Row="1"
          Grid.Column="2">
      <ContentPresenter x:Name="InfoPage"
                        Visibility="{Binding IsPageDatabase, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <ContentPresenter x:Name="EntriesPage"
                        Visibility="{Binding IsPageEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <ContentPresenter x:Name="UsersPage"
                        Visibility="{Binding IsPageUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>
