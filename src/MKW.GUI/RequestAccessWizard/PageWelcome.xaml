<wizard:WizardPage x:Class="MKW.GUI.RequestAccessWizard.PageWelcome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:MKW.GUI.RequestAccessWizard"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance Type=local:RequestAccessWizardViewModel}"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <TextBlock TextWrapping="Wrap">
        This will create a request file that you can send to database owner
        to request access to the database.
      </TextBlock>
    </StackPanel>
  </Grid>
</wizard:WizardPage>
