<wizard:WizardPage x:Class="MKW.GUI.ImportWizard.PageConfirmation"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:gui="clr-namespace:MKW.GUI"
                   xmlns:local="clr-namespace:MKW.GUI.ImportWizard"
                   xmlns:wizard="clr-namespace:MKW.GUI.Wizard"
                   xmlns:system="clr-namespace:System;assembly=mscorlib"
                   d:DataContext="{d:DesignInstance Type=local:ImportWizardViewModel}"
                   mc:Ignorable="d"
                   d:DesignHeight="380" d:DesignWidth="520"
                   d:Background="White">
  <Grid Margin="12">
    <StackPanel Orientation="Vertical">
      <TextBlock TextWrapping="Wrap"
                 Margin="0,0,0,12">
        Please verify that the information below is correct...
      </TextBlock>

    </StackPanel>
  </Grid>
</wizard:WizardPage>
