<Window x:Class="MKW.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="450" Width="800"
        Closed="Window_Closed"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.Close" Key="F4" Modifiers="Ctrl" />
    <KeyBinding Command="{x:Static local:AppCommands.LockDatabase}" Key="L" Modifiers="Ctrl" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static local:AppCommands.About}"
                    Executed="HelpAbout_Executed" />
    <CommandBinding Command="ApplicationCommands.Close"
                    Executed="FileClose_Executed"
                    CanExecute="FileClose_CanExecute"/>
    <CommandBinding Command="{x:Static local:AppCommands.Exit}"
                    Executed="FileExit_Executed" />
    <CommandBinding Command="ApplicationCommands.Open"
                    Executed="FileOpenCommand_Executed" />
    <CommandBinding Command="{x:Static local:AppCommands.OpenRecent}"
                    Executed="FileOpenRecentCommand_Executed" />
    <CommandBinding Command="ApplicationCommands.New"
                    Executed="FileNew_Executed" />
  </Window.CommandBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Menu Grid.Column="0" Grid.Row="0" 
          KeyboardNavigation.TabNavigation="None">
      <MenuItem Header="_File" >
        <MenuItem Header="_New" Command="ApplicationCommands.New" />
        <MenuItem Header="_Open" Command="ApplicationCommands.Open" />

        <MenuItem Header="_Recent Files"
                  ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding Path=HasItems, RelativeSource={RelativeSource Self}}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="MenuItem">
                    <MenuItem Header="{Binding FileName}"
                              Command="{x:Static local:AppCommands.OpenRecent}"
                              CommandParameter="{Binding FullPath}"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Close" Command="ApplicationCommands.Close" />
        <Separator />
        <MenuItem Header="_Lock Database" 
                  Command="{x:Static local:AppCommands.LockDatabase}" />
        <MenuItem Header="_Exit" Command="{x:Static local:AppCommands.Exit}" />
      </MenuItem>

      <MenuItem Header="_Entry">
        <MenuItem Header="Add Entry" />

        <MenuItem Header="Edit Entry" />

        <MenuItem Header="Delete Entry" />
      </MenuItem>

      <MenuItem Header="_User">
        <MenuItem Header="_Add User..." />

        <MenuItem Header="_Properties..." />

        <MenuItem Header="_Delete..." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Multi-Key Wallet"
                  Command="{x:Static local:AppCommands.About}" />
      </MenuItem>
    </Menu>

    <local:StartPage Grid.Row="1"
                     Visibility="{Binding IsStartPageVisible,
                                          Converter={StaticResource BooleanToVisibilityConverter}}"
                     Background="White"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     KeyboardNavigation.TabNavigation="Contained"/>

    <TabControl Grid.Row="1"
                Margin="6"
                ItemsSource="{Binding TabItems}"
                SelectedItem="{Binding SelectedTab}"
                Visibility="{Binding IsTabControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Header}"
                       Margin="0,0,3,0" />

            <Button Padding="1"
                    Margin="0,2,0,0"
                    Height="14"
                    Background="Transparent"
                    Foreground="Transparent"
                    BorderThickness="0"
                    Command="ApplicationCommands.Close"
                    CommandParameter="{Binding}">
              <local:CrispImage Moniker="Close" />
            </Button>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.Resources>
        <DataTemplate DataType="{x:Type local:DatabaseTabItemViewModel}">
          <ContentPresenter Content="{Binding Content}" />
        </DataTemplate>
      </TabControl.Resources>
    </TabControl>
  </Grid>
</Window>
