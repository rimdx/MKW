<Window x:Class="MKW.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MKW.GUI"
        xmlns:images="clr-namespace:MKW.GUI.Images;assembly=MKW.GUI.Images" xmlns:model="clr-namespace:MKW.GUI.Model"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="720" Width="950"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.Close" Key="F4" Modifiers="Ctrl" />
    <KeyBinding Command="{x:Static local:AppCommands.LockDatabase}" Key="L" Modifiers="Ctrl" />
  </Window.InputBindings>

  <Window.CommandBindings>
    <CommandBinding Command="{x:Static local:AppCommands.About}"
                    Executed="HelpAbout_Executed" />

    <CommandBinding Command="ApplicationCommands.Close"
                    Executed="FileClose_Executed"
                    CanExecute="FileClose_CanExecute"/>

    <CommandBinding Command="{x:Static local:AppCommands.Exit}"
                    Executed="FileExit_Executed" />

    <CommandBinding Command="ApplicationCommands.Open"
                    Executed="FileOpenCommand_Executed" />

    <CommandBinding Command="{x:Static local:AppCommands.OpenRecent}"
                    Executed="FileOpenRecentCommand_Executed" />

    <CommandBinding Command="ApplicationCommands.New"
                    Executed="FileNew_Executed" />
  </Window.CommandBindings>

  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top"
          KeyboardNavigation.TabNavigation="None">
      <MenuItem Header="_File" >
        <MenuItem Header="_New" Command="ApplicationCommands.New">
          <MenuItem.Icon>
            <local:CrispImage Moniker="NewDocument" />
          </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="_Open" Command="ApplicationCommands.Open">
          <MenuItem.Icon>
            <local:CrispImage Moniker="OpenFile" />
          </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="_Recent Files"
                  ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding Path=HasItems, RelativeSource={RelativeSource Self}}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="MenuItem">
                    <MenuItem Header="{Binding FileName}"
                              Command="{x:Static local:AppCommands.OpenRecent}"
                              CommandParameter="{Binding FullPath}" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>

        <Separator />

        <MenuItem Header="_Close" Command="ApplicationCommands.Close">
          <MenuItem.Icon>
            <local:CrispImage Moniker="CloseSolution" />
          </MenuItem.Icon>
        </MenuItem>

        <Separator />

        <MenuItem Header="_Lock Database"
                  Command="{x:Static local:AppCommands.LockDatabase}"
                  CommandTarget="{Binding Path=SelectedTab.Content}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="Lock" />
          </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="_Exit" Command="{x:Static local:AppCommands.Exit}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="CloseAll" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_Entry">
        <MenuItem Header="Copy _User Name"
                  Command="{x:Static local:EntryCommands.CopyProperty}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}"
                  CommandParameter="{x:Static model:CommonEntryPropertiesModel.Username}" />

        <MenuItem Header="Copy _Password"
                  Command="{x:Static local:EntryCommands.CopyProperty}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}"
                  CommandParameter="{x:Static model:CommonEntryPropertiesModel.Password}" />

        <Separator />

        <MenuItem Header="Add Entry..."
                  Command="{x:Static local:EntryCommands.AddEntry}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="NewKey" />
          </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="Edit Entry"
                  Command="{x:Static local:EntryCommands.EditEntry}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="EditKey" />
          </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="Delete Entry"
                  Command="{x:Static local:EntryCommands.DeleteEntry}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="DeleteKey" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_Data">
        <MenuItem Header="_Import"
                  Command="{x:Static local:AppCommands.DataImport}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="Import" />
          </MenuItem.Icon>
        </MenuItem>

        <MenuItem Header="_Export"
                  Command="{x:Static local:AppCommands.DataExport}"
                  CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}">
          <MenuItem.Icon>
            <local:CrispImage Moniker="Export" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="_About Multi-Key Wallet"
                  Command="{x:Static local:AppCommands.About}" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top"
                 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                 IsLocked="true"
                 KeyboardNavigation.TabNavigation="None">
      <ToolBar Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
               OverflowMode="Never">
        <Button Command="ApplicationCommands.New" ToolTip="New Database">
          <local:CrispImage Moniker="NewDocument" />
        </Button>
        <Button Command="ApplicationCommands.Open" ToolTip="Open Database">
          <local:CrispImage Moniker="OpenFile" />
        </Button>
        <Separator />
        <Button ToolTip="New Entry" 
                Command="{x:Static local:EntryCommands.AddEntry}"
                CommandTarget="{Binding Path=SelectedTab.DatabaseViewModel.ContentView}">
          <local:CrispImage Moniker="NewKey" />
        </Button>
        <Separator />
        <Button Command="{x:Static local:AppCommands.LockDatabase}" 
                CommandTarget="{Binding Path=SelectedTab.Content}"
                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTip="Lock Database">
          <local:CrispImage Moniker="Lock" />
        </Button>
        <Button Command="{x:Static local:AppCommands.UnlockDatabase}" 
                CommandTarget="{Binding Path=SelectedTab.Content}"
                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
                ToolTip="Unlock Database">
          <local:CrispImage Moniker="Lock" />
        </Button>
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <local:StartPage Visibility="{Binding IsStartPageVisible,
                                          Converter={StaticResource BooleanToVisibilityConverter}}"
                       Background="White"
                       KeyboardNavigation.DirectionalNavigation="Contained"
                       KeyboardNavigation.TabNavigation="Contained"/>

      <TabControl Margin="6"
                  x:Name="ctlTabControl"
                  ItemsSource="{Binding TabItems}"
                  SelectedItem="{Binding SelectedTab}"
                  FocusManager.IsFocusScope="True"
                  KeyboardNavigation.IsTabStop="False"
                  Visibility="{Binding IsTabControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Style="{StaticResource DocumentTabControl}">
        <TabControl.CommandBindings>
          <!--<CommandBinding Command="{x:Static local:AppCommands.LockDatabase}" 
                        CanExecute="CommandBinding_CanExecute"
                        Executed="CommandBinding_Executed"/>-->
        </TabControl.CommandBindings>
        <TabControl.ItemTemplate>
          <DataTemplate>
            <Grid MinWidth="80" ToolTip="{Binding Tooltip}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <local:CrispImage Grid.Column="0"
                                Moniker="{Binding Icon}"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{Binding Header}"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center" />

              <Button Grid.Column="2"
                      Padding="1"
                      Margin="0,0,0,0"
                      Height="14"
                      Background="Transparent"
                      Foreground="Transparent"
                      BorderThickness="0"
                      Command="ApplicationCommands.Close"
                      CommandParameter="{Binding}"
                      VerticalAlignment="Center">
                <local:CrispImage Moniker="Close" />
              </Button>
            </Grid>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate DataType="{x:Type local:DatabaseTabItemViewModel}">
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
              <ContentPresenter Content="{Binding Content}" />
            </Border>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
