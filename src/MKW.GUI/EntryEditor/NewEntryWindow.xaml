<gui:DialogWindow x:Class="MKW.GUI.EntryEditor.NewEntryWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:gui="clr-namespace:MKW.GUI"
                  xmlns:local="clr-namespace:MKW.GUI.EntryEditor"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance Type=local:NewEntryWindowViewModel}"
                  Title="Create New Secret Entry"
                  Height="380" Width="520"
                  Background="{DynamicResource ResourceKey={x:Static SystemColors.ControlBrushKey}}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <local:PayloadEditor DataContext="{Binding}" />

    <StackPanel Grid.Row="1"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

      <Button Grid.Column="1"
              Content="OK"
              Width="70"
              Click="OK_Click"
              IsDefault="True"
              Margin="0,0,6,0" />

      <Button Grid.Column="2"
              Content="Cancel"
              Width="70"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</gui:DialogWindow>
