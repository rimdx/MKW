<UserControl x:Class="MKW.GUI.EntryEditor.PayloadEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MKW.GUI.EntryEditor"
             xmlns:gui="clr-namespace:MKW.GUI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=gui:EntryPayloadEditorViewModel}"
             d:DesignHeight="380" d:DesignWidth="520"
             d:Background="White">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Label Grid.Row="0"
            Content="Entry content:"
            Target="PayloadInput"
            Margin="0,0,0,3"
            Padding="0" />

    <TextBox x:Name="PayloadInput"
             Grid.Row="1"
             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
             FontFamily="Consolas"
             AcceptsReturn="True"
             Margin="0,0,0,6" />
  </Grid>
</UserControl>
